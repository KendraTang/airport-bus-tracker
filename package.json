{
  "name": "airport-bus-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "collect": "node src/cli/collect.ts",
    "export": "node src/cli/export.ts",
    "dev": "npm run export && vite web",
